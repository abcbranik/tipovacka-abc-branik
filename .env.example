# Copy this file to .env and adjust as needed.
# This copy of the project targets Postgres (e.g. a free Neon database).

# Postgres connection string, e.g. from Neon's dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate a random secret, e.g. with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"

# Public URL of the running app (used by next-auth for callbacks).
NEXTAUTH_URL="https://your-app.vercel.app"

# Seeded superadmin account (created automatically as part of `npm run build`,
# see package.json - the seed script is idempotent so it's safe to run on
# every deploy). Change the password after first login!
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="zmenteheslo123"
